<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivVideoLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="video_left"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/ivVideoRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="video_right"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/pageContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/pageManual"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageButton
                    android:id="@+id/btnModeToggle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="toggle_settings"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_settings_gear"
                    android:tint="#FFFFFF" />

                <HorizontalScrollView
                    android:id="@+id/remoteControlsBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="44dp"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnArm"
                            android:layout_width="86dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_oval_button"
                            android:minHeight="34dp"
                            android:text="ARM"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btnEmergencyStop"
                            android:layout_width="92dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_oval_button"
                            android:minHeight="34dp"
                            android:text="E-STOP"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/btnLand"
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_oval_button"
                            android:minHeight="34dp"
                            android:text="LAND"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="44dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnQuickSlamAuto"
                        android:layout_width="96dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_settings_button"
                        android:minHeight="36dp"
                        android:text="Auto Off"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnQuickSlamManual"
                        android:layout_width="96dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_settings_button"
                        android:minHeight="36dp"
                        android:text="Mapping"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/joystickLeft"
                    android:layout_width="192dp"
                    android:layout_height="192dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:alpha="0.92">

                    <ImageButton
                        android:id="@+id/btnLeftUp"
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="-8dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="altitude_up"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_control_altitude_up" />

                    <TextView
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="-8dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/ctrl_alt_up"
                        android:textAllCaps="true"
                        android:textColor="#EFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnLeftDown"
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="-8dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="altitude_down"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_control_altitude_down" />

                    <TextView
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="-8dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/ctrl_alt_down"
                        android:textAllCaps="true"
                        android:textColor="#EFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnLeftYawLeft"
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="-8dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="yaw_left"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_control_yaw_left" />

                    <TextView
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="-8dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/ctrl_yaw_left"
                        android:textAllCaps="true"
                        android:textColor="#EFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnLeftYawRight"
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="-8dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="yaw_right"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_control_yaw_right" />

                    <TextView
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="-8dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/ctrl_yaw_right"
                        android:textAllCaps="true"
                        android:textColor="#EFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/joystickRight"
                    android:layout_width="192dp"
                    android:layout_height="192dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="6dp"
                    android:alpha="0.92">

                    <ImageButton
                        android:id="@+id/btnRightForward"
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="-8dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="move_forward"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_control_move_ground_forward" />

                    <TextView
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="-8dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/ctrl_forward"
                        android:textAllCaps="true"
                        android:textColor="#EFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnRightBack"
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="-8dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="move_back"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_control_move_ground_back" />

                    <TextView
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="-8dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/ctrl_back"
                        android:textAllCaps="true"
                        android:textColor="#EFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnRightLeft"
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="-8dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="move_left"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_control_move_ground_left" />

                    <TextView
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="-8dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/ctrl_left"
                        android:textAllCaps="true"
                        android:textColor="#EFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnRightRight"
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="-8dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="move_right"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_control_move_ground_right" />

                    <TextView
                        android:layout_width="99dp"
                        android:layout_height="99dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="-8dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="@string/ctrl_right"
                        android:textAllCaps="true"
                        android:textColor="#EFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/mapPanel"
                    android:layout_width="260dp"
                    android:layout_height="180dp"
                    android:layout_gravity="top|start"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="0dp">

                    <com.example.smartdrone.Map3DView
                        android:id="@+id/map3dView"
                        android:layout_width="260dp"
                        android:layout_height="180dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnMapClear"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_button"
                            android:contentDescription="clear_point_cloud"
                            android:padding="7dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_eraser"
                            android:tint="#FFFFFF" />

                        <ImageButton
                            android:id="@+id/btnMapZoom"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_circle_button"
                            android:contentDescription="toggle_map_zoom"
                            android:padding="7dp"
                            android:scaleType="centerInside"
                            android:src="@android:drawable/ic_menu_search"
                            android:tint="#FFFFFF" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/pageCommand"
                android:layout_width="360dp"
                android:layout_height="320dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_settings_panel"
                android:elevation="12dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Runtime Settings"
                    android:textColor="#183247"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <AutoCompleteTextView
                                android:id="@+id/etVehicleIp"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="#F7FAFC"
                                android:hint="Vehicle IP"
                                android:inputType="textUri"
                                android:minHeight="40dp"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp"
                                android:singleLine="true"
                                android:completionThreshold="1"
                                android:text=""
                                android:textColor="#183247"
                                android:textColorHint="#6B7A8C"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etSshUser"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="#F7FAFC"
                                android:hint="SSH User"
                                android:inputType="textPersonName"
                                android:minHeight="40dp"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp"
                                android:singleLine="true"
                                android:textColor="#183247"
                                android:textColorHint="#6B7A8C"
                                android:textSize="12sp" />

                            <EditText
                                android:id="@+id/etSshPassword"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="#F7FAFC"
                                android:hint="SSH Password"
                                android:inputType="textPassword"
                                android:minHeight="40dp"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp"
                                android:singleLine="true"
                                android:textColor="#183247"
                                android:textColorHint="#6B7A8C"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCfgExposureValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Exposure: 3000 us"
                            android:textColor="#183247"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/sbCfgExposure"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="Exposure slider" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="500 us step, 500-20000 us"
                            android:textColor="#667085"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvCfgGainValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Gain: 2"
                            android:textColor="#183247"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/sbCfgGain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="Gain slider" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="4dp"
                            android:text="1 step, 1-32"
                            android:textColor="#667085"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvCfgPairMsValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Pair Window: 5 ms"
                            android:textColor="#183247"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/sbCfgPairMs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="Pair window slider" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="4dp"
                            android:text="1 ms step, 1-20 ms"
                            android:textColor="#667085"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvCfgSlamFpsValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="SLAM FPS: 30"
                            android:textColor="#183247"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/sbCfgSlamFps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="SLAM fps slider" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="4dp"
                            android:text="1 fps step, 1-60 fps"
                            android:textColor="#667085"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="12dp"
                            android:background="#33FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingLeft="12dp"
                            android:paddingRight="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ORB-SLAM3"
                                android:textColor="#183247"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <Switch
                                android:id="@+id/btnToggleSlam"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="46dp"
                                android:showText="false"
                                android:splitTrack="false"
                                android:switchMinWidth="46dp"
                                android:thumb="@drawable/switch_thumb"
                                android:track="@drawable/switch_track" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="#33FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingLeft="12dp"
                            android:paddingTop="8dp"
                            android:paddingRight="12dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sensor Mode"
                                android:textColor="#183247"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinnerSensorMode"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="6dp"
                                android:background="#F7FAFC"
                                android:paddingLeft="10dp"
                                android:paddingRight="10dp"
                                android:spinnerMode="dropdown" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:background="#33FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingLeft="12dp"
                            android:paddingRight="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Display Image"
                                android:textColor="#183247"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <Switch
                                android:id="@+id/btnImageToggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:minWidth="42dp"
                                android:showText="false"
                                android:splitTrack="false"
                                android:switchMinWidth="42dp"
                                android:thumb="@drawable/switch_thumb"
                                android:track="@drawable/switch_track" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:background="#33FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingLeft="12dp"
                            android:paddingRight="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Display 3DMap"
                                android:textColor="#183247"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <Switch
                                android:id="@+id/btnMapToggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:minWidth="42dp"
                                android:showText="false"
                                android:splitTrack="false"
                                android:switchMinWidth="42dp"
                                android:thumb="@drawable/switch_thumb"
                                android:track="@drawable/switch_track" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:background="#33FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingLeft="12dp"
                            android:paddingRight="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Display Features"
                                android:textColor="#183247"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <Switch
                                android:id="@+id/btnFeatureToggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:minWidth="42dp"
                                android:showText="false"
                                android:splitTrack="false"
                                android:switchMinWidth="42dp"
                                android:thumb="@drawable/switch_thumb"
                                android:track="@drawable/switch_track" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:background="#33FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingLeft="12dp"
                            android:paddingRight="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Calib Collect"
                                android:textColor="#183247"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <Switch
                                android:id="@+id/btnToggleCalib"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="46dp"
                                android:showText="false"
                                android:splitTrack="false"
                                android:switchMinWidth="46dp"
                                android:thumb="@drawable/switch_thumb"
                                android:track="@drawable/switch_track" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnCleanCalib"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_settings_button"
                            android:minHeight="40dp"
                            android:text="Calib Clean"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnRestartService"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_settings_button"
                            android:minHeight="40dp"
                            android:text="SSH Kill SmartDrone"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:background="#33FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingLeft="12dp"
                            android:paddingRight="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Remote Control"
                                android:textColor="#183247"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <Switch
                                android:id="@+id/btnRemoteToggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:minWidth="42dp"
                                android:showText="false"
                                android:splitTrack="false"
                                android:switchMinWidth="42dp"
                                android:thumb="@drawable/switch_thumb"
                                android:track="@drawable/switch_track" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:background="#33FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingLeft="12dp"
                            android:paddingRight="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Debug Info"
                                android:textColor="#183247"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <Switch
                                android:id="@+id/btnDebugToggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:minWidth="42dp"
                                android:showText="false"
                                android:splitTrack="false"
                                android:switchMinWidth="42dp"
                                android:thumb="@drawable/switch_thumb"
                                android:track="@drawable/switch_track" />
                        </LinearLayout>

                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvPose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:background="#66101822"
        android:elevation="6dp"
        android:maxWidth="170dp"
        android:paddingLeft="8dp"
        android:paddingTop="5dp"
        android:paddingRight="8dp"
        android:paddingBottom="5dp"
        android:text="Waiting for vehicle pose..."
        android:textColor="#F2FFFFFF"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/debugPanel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="#4D0B1220"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="cm5udp ready"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
