<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size
                android:width="46dp"
                android:height="26dp" />
            <corners android:radius="13dp" />
            <solid android:color="#1F6FEB" />
            <stroke
                android:width="1dp"
                android:color="#0B3D91" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <size
                android:width="46dp"
                android:height="26dp" />
            <corners android:radius="13dp" />
            <solid android:color="#D0D5DD" />
            <stroke
                android:width="1dp"
                android:color="#98A2B3" />
        </shape>
    </item>
</selector>
