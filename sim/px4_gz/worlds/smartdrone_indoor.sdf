<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="smartdrone_hover">
    <physics name="smartdrone_4ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench">
      <verbose>false</verbose>
    </plugin>

    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <scene>
      <grid>false</grid>
      <ambient>0.32 0.32 0.32 1</ambient>
      <background>0.18 0.20 0.22 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="ceiling_key" type="spot">
      <pose>0 0 3.8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.2</intensity>
      <direction>0.25 0 -1</direction>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <spot><inner_angle>0.4</inner_angle><outer_angle>1.5</outer_angle><falloff>0.2</falloff></spot>
      <attenuation><range>20</range><constant>0.25</constant><linear>0.03</linear><quadratic>0.001</quadratic></attenuation>
    </light>
    <light name="front_fill" type="point">
      <pose>4 -2 2.8 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>0.8</intensity>
      <diffuse>0.70 0.78 0.95 1</diffuse>
      <specular>0.15 0.15 0.18 1</specular>
      <attenuation><range>14</range><constant>0.35</constant><linear>0.04</linear><quadratic>0.002</quadratic></attenuation>
    </light>

    <model name="smartdrone_textured_arena">
      <static>true</static>
      <link name="arena">
        <collision name="floor_collision">
          <geometry><box><size>12 10 0.1</size></box></geometry>
          <pose>0 0 -0.05 0 0 0</pose>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="floor_base">
          <geometry><box><size>12 10 0.02</size></box></geometry>
          <pose>0 0 -0.01 0 0 0</pose>
          <material>
            <ambient>0.42 0.42 0.40 1</ambient><diffuse>0.48 0.48 0.45 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
            <pbr><metal><albedo_map>model://smartdrone_indoor_assets/materials/textures/floor_features.png</albedo_map><metalness>0.0</metalness><roughness>0.9</roughness></metal></pbr>
          </material>
        </visual>

        <!-- Irregular high-contrast floor patches provide close stereo features. -->
        <visual name="floor_patch_01"><pose>1.4 -0.25 0.006 0 0 0.12</pose><geometry><box><size>0.9 0.45 0.012</size></box></geometry><material><ambient>0.06 0.06 0.06 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <visual name="floor_patch_02"><pose>2.5 0.35 0.006 0 0 -0.18</pose><geometry><box><size>0.55 1.15 0.012</size></box></geometry><material><ambient>0.88 0.88 0.86 1</ambient><diffuse>0.94 0.94 0.91 1</diffuse></material></visual>
        <visual name="floor_patch_03"><pose>4.2 -0.55 0.006 0 0 0.43</pose><geometry><box><size>1.2 0.35 0.012</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
        <visual name="floor_patch_04"><pose>-2.2 2.1 0.006 0 0 0.31</pose><geometry><box><size>0.7 0.7 0.012</size></box></geometry><material><ambient>0.80 0.80 0.78 1</ambient><diffuse>0.88 0.88 0.84 1</diffuse></material></visual>
        <visual name="floor_patch_05"><pose>-3.8 -1.0 0.006 0 0 -0.22</pose><geometry><box><size>1.4 0.28 0.012</size></box></geometry><material><ambient>0.10 0.10 0.10 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
        <visual name="floor_patch_06"><pose>0.6 3.3 0.006 0 0 0.67</pose><geometry><box><size>0.45 1.25 0.012</size></box></geometry><material><ambient>0.91 0.91 0.88 1</ambient><diffuse>0.96 0.96 0.92 1</diffuse></material></visual>
        <visual name="floor_patch_07"><pose>-1.2 -3.1 0.006 0 0 -0.48</pose><geometry><box><size>0.95 0.50 0.012</size></box></geometry><material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.23 0.23 0.23 1</diffuse></material></visual>
        <visual name="floor_patch_08"><pose>5.0 0.8 0.006 0 0 0.10</pose><geometry><box><size>0.75 0.75 0.012</size></box></geometry><material><ambient>0.74 0.74 0.72 1</ambient><diffuse>0.82 0.82 0.78 1</diffuse></material></visual>
        <visual name="floor_patch_09"><pose>-4.7 3.2 0.006 0 0 0.54</pose><geometry><cylinder><radius>0.42</radius><length>0.012</length></cylinder></geometry><material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material></visual>
        <visual name="floor_patch_10"><pose>3.1 3.7 0.006 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.012</length></cylinder></geometry><material><ambient>0.92 0.92 0.90 1</ambient><diffuse>0.98 0.98 0.95 1</diffuse></material></visual>

        <collision name="front_wall_collision"><pose>6 0 2 0 0 0</pose><geometry><box><size>0.1 10 4</size></box></geometry></collision>
        <visual name="front_wall">
          <pose>6 0 2 0 0 0</pose><geometry><box><size>0.1 10 4</size></box></geometry>
          <material>
            <ambient>0.55 0.56 0.57 1</ambient><diffuse>0.62 0.63 0.64 1</diffuse>
            <pbr><metal><albedo_map>model://smartdrone_indoor_assets/materials/textures/wall_features.png</albedo_map><metalness>0.0</metalness><roughness>0.85</roughness></metal></pbr>
          </material>
        </visual>

        <!-- Non-repeating front-wall fiducial field; no Fuel or external textures. -->
        <visual name="front_mark_01"><pose>5.944 -3.8 0.55 0 0 0</pose><geometry><box><size>0.018 0.52 0.72</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
        <visual name="front_mark_02"><pose>5.942 -2.7 1.30 0 0 0</pose><geometry><sphere><radius>0.34</radius></sphere></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual>
        <visual name="front_mark_03"><pose>5.943 -1.75 2.45 0 0 0.25</pose><geometry><box><size>0.02 0.42 1.05</size></box></geometry><material><ambient>0.10 0.10 0.10 1</ambient><diffuse>0.13 0.13 0.13 1</diffuse></material></visual>
        <visual name="front_mark_04"><pose>5.941 -0.65 0.82 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse></material></visual>
        <visual name="front_mark_05"><pose>5.942 0.35 1.85 0 0 -0.31</pose><geometry><box><size>0.02 0.82 0.30</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
        <visual name="front_mark_06"><pose>5.941 1.45 3.05 0 0 0</pose><geometry><sphere><radius>0.40</radius></sphere></geometry><material><ambient>0.90 0.90 0.88 1</ambient><diffuse>0.98 0.98 0.94 1</diffuse></material></visual>
        <visual name="front_mark_07"><pose>5.943 2.55 1.05 0 0 0.45</pose><geometry><box><size>0.02 0.35 1.15</size></box></geometry><material><ambient>0.14 0.14 0.14 1</ambient><diffuse>0.17 0.17 0.17 1</diffuse></material></visual>
        <visual name="front_mark_08"><pose>5.942 3.75 2.20 0 0 0</pose><geometry><sphere><radius>0.27</radius></sphere></geometry><material><ambient>0.82 0.82 0.80 1</ambient><diffuse>0.90 0.90 0.86 1</diffuse></material></visual>
        <visual name="front_mark_09"><pose>5.942 -3.9 3.15 0 0 -0.22</pose><geometry><box><size>0.02 0.95 0.20</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.21 0.21 0.21 1</diffuse></material></visual>
        <visual name="front_mark_10"><pose>5.941 4.25 0.55 0 0 0.18</pose><geometry><box><size>0.02 0.38 0.82</size></box></geometry><material><ambient>0.94 0.94 0.90 1</ambient><diffuse>0.99 0.99 0.95 1</diffuse></material></visual>

        <collision name="left_wall_collision"><pose>0 5 2 0 0 0</pose><geometry><box><size>12 0.1 4</size></box></geometry></collision>
        <visual name="left_wall"><pose>0 5 2 0 0 0</pose><geometry><box><size>12 0.1 4</size></box></geometry><material><ambient>0.46 0.49 0.52 1</ambient><diffuse>0.52 0.56 0.60 1</diffuse></material></visual>
        <visual name="left_mark_01"><pose>1.1 4.944 1.0 0 0 0.3</pose><geometry><box><size>0.65 0.018 0.9</size></box></geometry><material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material></visual>
        <visual name="left_mark_02"><pose>3.4 4.942 2.6 0 0 0</pose><geometry><sphere><radius>0.36</radius></sphere></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="left_mark_03"><pose>-2.0 4.943 2.1 0 0 -0.4</pose><geometry><box><size>1.1 0.02 0.26</size></box></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="left_mark_04"><pose>-4.4 4.941 0.8 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry><material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.86 0.86 0.82 1</diffuse></material></visual>

        <collision name="right_wall_collision"><pose>0 -5 2 0 0 0</pose><geometry><box><size>12 0.1 4</size></box></geometry></collision>
        <visual name="right_wall"><pose>0 -5 2 0 0 0</pose><geometry><box><size>12 0.1 4</size></box></geometry><material><ambient>0.50 0.47 0.44 1</ambient><diffuse>0.58 0.54 0.50 1</diffuse></material></visual>
        <visual name="right_mark_01"><pose>2.2 -4.944 0.9 0 0 -0.2</pose><geometry><box><size>0.55 0.018 1.05</size></box></geometry><material><ambient>0.92 0.92 0.90 1</ambient><diffuse>0.98 0.98 0.95 1</diffuse></material></visual>
        <visual name="right_mark_02"><pose>4.5 -4.942 2.7 0 0 0</pose><geometry><sphere><radius>0.31</radius></sphere></geometry><material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.09 0.09 0.09 1</diffuse></material></visual>
        <visual name="right_mark_03"><pose>-1.0 -4.943 2.4 0 0 0.35</pose><geometry><box><size>1.25 0.02 0.22</size></box></geometry><material><ambient>0.16 0.16 0.16 1</ambient><diffuse>0.19 0.19 0.19 1</diffuse></material></visual>
        <visual name="right_mark_04"><pose>-3.7 -4.941 1.1 0 0 0</pose><geometry><sphere><radius>0.39</radius></sphere></geometry><material><ambient>0.84 0.84 0.81 1</ambient><diffuse>0.91 0.91 0.87 1</diffuse></material></visual>

        <collision name="back_wall_collision"><pose>-6 0 2 0 0 0</pose><geometry><box><size>0.1 10 4</size></box></geometry></collision>
        <visual name="back_wall"><pose>-6 0 2 0 0 0</pose><geometry><box><size>0.1 10 4</size></box></geometry><material><ambient>0.42 0.44 0.43 1</ambient><diffuse>0.48 0.50 0.49 1</diffuse></material></visual>

        <!-- These depths and azimuths stay inside the stereo camera's +/-20.7 degree horizontal FOV. -->
        <collision name="pillar_1_collision"><pose>2.2 -0.6 1.0 0 0 0</pose><geometry><box><size>0.35 0.35 2.0</size></box></geometry></collision>
        <visual name="pillar_1">
          <pose>2.2 -0.6 1.0 0 0 0</pose><geometry><box><size>0.35 0.35 2.0</size></box></geometry>
          <material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.86 0.86 0.82 1</diffuse><pbr><metal><albedo_map>model://smartdrone_indoor_assets/materials/textures/wall_features.png</albedo_map><metalness>0.0</metalness><roughness>0.9</roughness></metal></pbr></material>
        </visual>
        <collision name="pillar_2_collision"><pose>3.4 0.6 0.75 0 0 0</pose><geometry><cylinder><radius>0.26</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="pillar_2"><pose>3.4 0.6 0.75 0 0 0</pose><geometry><cylinder><radius>0.26</radius><length>1.5</length></cylinder></geometry><material><ambient>0.10 0.10 0.10 1</ambient><diffuse>0.13 0.13 0.13 1</diffuse></material></visual>
        <collision name="crate_collision"><pose>4.5 -0.05 0.6 0 0 0.28</pose><geometry><box><size>0.8 0.8 1.2</size></box></geometry></collision>
        <visual name="crate">
          <pose>4.5 -0.05 0.6 0 0 0.28</pose><geometry><box><size>0.8 0.8 1.2</size></box></geometry>
          <material><ambient>0.26 0.27 0.28 1</ambient><diffuse>0.31 0.32 0.33 1</diffuse><pbr><metal><albedo_map>model://smartdrone_indoor_assets/materials/textures/floor_features.png</albedo_map><metalness>0.0</metalness><roughness>0.95</roughness></metal></pbr></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://smartdrone_x500_stereo</uri>
      <name>smartdrone_x500</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <gui fullscreen="false">
      <plugin filename="GzScene3D" name="3D View">
        <gz-gui><title>SmartDrone Hover</title><property type="bool" key="showTitleBar">0</property><property type="string" key="state">docked</property></gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <camera_pose>-5 -5 4.5 0 0.48 0.72</camera_pose>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui><title>World control</title><property type="bool" key="showTitleBar">0</property><property type="string" key="state">floating</property></gz-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui><title>World stats</title><property type="bool" key="showTitleBar">0</property><property type="string" key="state">floating</property></gz-gui>
        <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor><iterations>true</iterations>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"/>
    </gui>
  </world>
</sdf>
