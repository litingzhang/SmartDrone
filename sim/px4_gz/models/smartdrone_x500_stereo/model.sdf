<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="smartdrone_x500_stereo">
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <!-- T_b_c1 = [R_optical_to_FRD, (0.10, -0.035, 0.0)].
         Gazebo links are FLU, so the left camera has y=+0.035. -->
    <link name="smartdrone_left_camera_link">
      <pose relative_to="base_link">0.10 0.035 0 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <sensor name="smartdrone_left_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/smartdrone/stereo/left/image</topic>
        <gz_frame_id>smartdrone_left_camera_optical</gz_frame_id>
        <camera>
          <camera_info_topic>/smartdrone/stereo/left/camera_info</camera_info_topic>
          <horizontal_fov>0.721518</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L_INT8</format>
            <anti_aliasing>0</anti_aliasing>
          </image>
          <clip><near>0.05</near><far>30.0</far></clip>
          <lens>
            <intrinsics>
              <fx>848.1995692597807</fx>
              <fy>850.7755678826038</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
          <optical_frame_id>smartdrone_left_camera_optical</optical_frame_id>
        </camera>
      </sensor>
    </link>
    <joint name="smartdrone_left_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>smartdrone_left_camera_link</child>
    </joint>
    <frame name="smartdrone_left_camera_optical" attached_to="smartdrone_left_camera_link">
      <pose relative_to="smartdrone_left_camera_link">0 0 0 -1.57079632679 0 -1.57079632679</pose>
    </frame>

    <!-- 0.035 - (-0.03492881426014412) = 0.06992881426014412 m. -->
    <link name="smartdrone_right_camera_link">
      <pose relative_to="base_link">0.10 -0.03492881426014412 0 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <sensor name="smartdrone_right_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/smartdrone/stereo/right/image</topic>
        <gz_frame_id>smartdrone_right_camera_optical</gz_frame_id>
        <camera>
          <camera_info_topic>/smartdrone/stereo/right/camera_info</camera_info_topic>
          <horizontal_fov>0.721518</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L_INT8</format>
            <anti_aliasing>0</anti_aliasing>
          </image>
          <clip><near>0.05</near><far>30.0</far></clip>
          <lens>
            <intrinsics>
              <fx>848.1995692597807</fx>
              <fy>850.7755678826038</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
          <optical_frame_id>smartdrone_right_camera_optical</optical_frame_id>
        </camera>
      </sensor>
    </link>
    <joint name="smartdrone_right_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>smartdrone_right_camera_link</child>
    </joint>
    <frame name="smartdrone_right_camera_optical" attached_to="smartdrone_right_camera_link">
      <pose relative_to="smartdrone_right_camera_link">0 0 0 -1.57079632679 0 -1.57079632679</pose>
    </frame>
  </model>
</sdf>
