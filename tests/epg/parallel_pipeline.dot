digraph ParallelPipeline {
  subgraph cluster_test_graph {
    label="Parallel Pipeline";

    left_source [label="{left_source|type=TestSourceTask|trigger=periodic|interval_ms=1}"];
    left_sink [label="{left_sink|type=TestSinkTask|trigger=any_queue_ready}"];
    right_source [label="{right_source|type=TestSecondSourceTask|trigger=periodic|interval_ms=1}"];
    right_sink [label="{right_sink|type=TestSinkTask|trigger=any_queue_ready}"];

    left_source -> left_sink [
      taillabel="0", headlabel="0", label="TestPacket\ndepth=8\noverflow=drop_newest"
    ];
    right_source -> right_sink [
      taillabel="0", headlabel="0", label="TestPacket\ndepth=8\noverflow=drop_newest"
    ];
  }
}
