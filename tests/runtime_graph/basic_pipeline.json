{
  "queues": [
    {
      "name": "packets",
      "type": "TestPacket",
      "depth": 8,
      "overflow": "drop_newest"
    }
  ],
  "tasks": [
    {
      "name": "source",
      "type": "TestSourceTask",
      "trigger": {
        "mode": "periodic",
        "interval_ms": 1
      },
      "outputs": {
        "out": "packets"
      }
    },
    {
      "name": "sink",
      "type": "TestSinkTask",
      "trigger": {
        "mode": "any_queue_ready",
        "queues": ["packets"]
      },
      "inputs": {
        "in": "packets"
      }
    }
  ]
}
