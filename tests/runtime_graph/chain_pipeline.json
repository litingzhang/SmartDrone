{
  "queues": [
    {
      "name": "source_to_forward",
      "type": "TestPacket",
      "depth": 8,
      "overflow": "drop_newest"
    },
    {
      "name": "forward_to_sink",
      "type": "TestPacket",
      "depth": 8,
      "overflow": "drop_newest"
    }
  ],
  "tasks": [
    {
      "name": "source",
      "type": "TestSourceTask",
      "trigger": {
        "mode": "periodic",
        "interval_ms": 1
      },
      "outputs": {
        "out": "source_to_forward"
      }
    },
    {
      "name": "forward",
      "type": "TestForwardTask",
      "trigger": {
        "mode": "any_queue_ready",
        "queues": ["source_to_forward"]
      },
      "inputs": {
        "in": "source_to_forward"
      },
      "outputs": {
        "out": "forward_to_sink"
      }
    },
    {
      "name": "sink",
      "type": "TestSinkTask",
      "trigger": {
        "mode": "any_queue_ready",
        "queues": ["forward_to_sink"]
      },
      "inputs": {
        "in": "forward_to_sink"
      }
    }
  ]
}
