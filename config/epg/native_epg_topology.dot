digraph NativeEventPipelineGraphTopology {
  graph [
    rankdir=TB,
    compound=true,
    labelloc=t,
    label="Native EventPipelineGraph Topology",
    fontsize=18,
    fontname="Helvetica",
    nodesep=0.35,
    ranksep=0.65
  ];

  node [
    shape=record,
    style="rounded,filled",
    fillcolor="#f7f9fb",
    color="#7d8896",
    fontname="Helvetica",
    fontsize=10
  ];

  edge [
    color="#4b5563",
    fontname="Helvetica",
    fontsize=9,
    arrowsize=0.8,
    labeldistance=1.7,
    labelangle=25
  ];

  subgraph cluster_supervisor_graph {
    label="Runtime Supervisor Graph";
    color="#a7b0bd";
    style="rounded,dashed";
    RuntimeSupervisorTask [
      label="{RuntimeSupervisorTask|type=RuntimeSupervisorTask|trigger=periodic|interval_ms=100}"
    ];
  }

  subgraph cluster_slam_session_graph {
    label="SLAM Session Graph";
    color="#a7b0bd";
    style="rounded";

    NativeSlamResourceTask [
      label="{NativeSlamResourceTask|type=NativeSlamResourceTask|trigger=periodic|interval_ms=1}"
    ];
    NativeSlamClockTask [
      label="{NativeSlamClockTask|type=NativeSlamClockTask|trigger=periodic|interval_ms=1}"
    ];
    NativeSlamImuGateTask [
      label="{NativeSlamImuGateTask|type=NativeSlamImuGateTask|trigger=any_queue_ready|trigger_queues=NativeSlamResourceReady+NativeSlamTick}"
    ];
    NativeSlamAcquireTask [
      label="{NativeSlamAcquireTask|type=NativeSlamAcquireTask|stage=frame_acquire_and_prepare|trigger=any_queue_ready|trigger_queues=NativeSlamFrameReady}"
    ];
    NativeSlamTrackingTask [
      label="{NativeSlamTrackingTask|type=NativeSlamTrackingTask|trigger=any_queue_ready|trigger_queues=NativeSlamPreparedFrame}"
    ];
    NativeSlamPosePostprocessTask [
      label="{NativeSlamPosePostprocessTask|type=NativeSlamPosePostprocessTask|trigger=any_queue_ready|trigger_queues=NativeSlamTrackedFrame}"
    ];
    NativeSlamPointCloudTask [
      label="{NativeSlamPointCloudTask|type=NativeSlamPointCloudTask|trigger=any_queue_ready|trigger_queues=NativeSlamPublishedFrame}"
    ];
    NativeSlamLivePoseTask [
      label="{NativeSlamLivePoseTask|type=NativeSlamLivePoseTask|trigger=any_queue_ready|trigger_queues=NativeSlamPublishedFrame}"
    ];
    NativeSlamMavlinkTask [
      label="{NativeSlamMavlinkTask|type=NativeSlamMavlinkTask|trigger=any_queue_ready|trigger_queues=NativeSlamPublishedFrame}"
    ];
    NativeSlamUdpTask [
      label="{NativeSlamUdpTask|type=NativeSlamUdpTask|trigger=any_queue_ready|trigger_queues=NativeSlamPublishedFrame}"
    ];
    NativeSlamDfxTask [
      label="{NativeSlamDfxTask|type=NativeSlamDfxTask|trigger=any_queue_ready|trigger_queues=NativeSlamPublishedFrame}"
    ];
    NativeSlamMonitorTask [
      label="{NativeSlamMonitorTask|type=NativeSlamMonitorTask|trigger=any_queue_ready|trigger_queues=NativeSlamStatus}"
    ];

    NativeSlamResourceTask -> NativeSlamImuGateTask [
      taillabel="0", headlabel="0", label="NativeSlamResourceReady\ndepth=1\noverflow=overwrite_oldest"
    ];
    NativeSlamClockTask -> NativeSlamImuGateTask [
      taillabel="0", headlabel="1", label="NativeSlamTick\ndepth=1\noverflow=overwrite_oldest"
    ];
    NativeSlamImuGateTask -> NativeSlamAcquireTask [
      taillabel="0", headlabel="0", label="NativeSlamFrameReady\ndepth=1\noverflow=overwrite_oldest"
    ];
    NativeSlamAcquireTask -> NativeSlamTrackingTask [
      taillabel="0", headlabel="0", label="NativeSlamPreparedFrame\ndepth=1\noverflow=overwrite_oldest"
    ];
    NativeSlamTrackingTask -> NativeSlamPosePostprocessTask [
      taillabel="0", headlabel="0", label="NativeSlamTrackedFrame\ndepth=1\noverflow=overwrite_oldest"
    ];
    NativeSlamPosePostprocessTask -> NativeSlamPointCloudTask [
      taillabel="0", headlabel="0", label="NativeSlamPublishedFrame\ndepth=1\noverflow=overwrite_oldest"
    ];
    NativeSlamPointCloudTask -> NativeSlamLivePoseTask [
      taillabel="0", headlabel="0", label="NativeSlamPublishedFrame\ndepth=1\noverflow=overwrite_oldest"
    ];
    NativeSlamLivePoseTask -> NativeSlamMavlinkTask [
      taillabel="0", headlabel="0", label="NativeSlamPublishedFrame\ndepth=1\noverflow=overwrite_oldest"
    ];
    NativeSlamMavlinkTask -> NativeSlamUdpTask [
      taillabel="0", headlabel="0", label="NativeSlamPublishedFrame\ndepth=1\noverflow=overwrite_oldest"
    ];
    NativeSlamUdpTask -> NativeSlamDfxTask [
      taillabel="0", headlabel="0", label="NativeSlamPublishedFrame\ndepth=1\noverflow=overwrite_oldest"
    ];
    NativeSlamDfxTask -> NativeSlamMonitorTask [
      taillabel="1", headlabel="0", label="NativeSlamStatus\ndepth=4\noverflow=overwrite_oldest"
    ];
  }

  subgraph cluster_calib_session_graph {
    label="Calibration Session Graph";
    color="#a7b0bd";
    style="rounded";

    CalibResourceTask [
      label="{CalibResourceTask|type=CalibResourceTask|trigger=periodic|interval_ms=1}"
    ];
    NativeCalibClockTask [
      label="{NativeCalibClockTask|type=NativeCalibClockTask|trigger=periodic|interval_ms=1}"
    ];
    CalibCameraAcquireTask [
      label="{CalibCameraAcquireTask|type=CalibCameraAcquireTask|trigger=any_queue_ready|trigger_queues=CalibResourceReady+NativeCalibTick}"
    ];
    CalibPacingFilterTask [
      label="{CalibPacingFilterTask|type=CalibPacingFilterTask|trigger=any_queue_ready|trigger_queues=CalibStereoFrame}"
    ];
    CalibStorageWriteTask [
      label="{CalibStorageWriteTask|type=CalibStorageWriteTask|trigger=any_queue_ready|trigger_queues=CalibSavePair}"
    ];
    CalibImuWriterTask [
      label="{CalibImuWriterTask|type=CalibImuWriterTask|trigger=periodic_or_any_queue_ready|interval_ms=1|trigger_queues=CalibResourceReady}"
    ];
    CalibUdpPreviewTask [
      label="{CalibUdpPreviewTask|type=CalibUdpPreviewTask|trigger=any_queue_ready|trigger_queues=CalibStereoFrame}"
    ];
    CalibCompletionTask [
      label="{CalibCompletionTask|type=CalibCompletionTask|trigger=any_queue_ready|trigger_queues=CalibCaptureDone+CalibStorageStatus+CalibImuStatus+CalibPreviewStatus}"
    ];
    CalibFlushSyncTask [
      label="{CalibFlushSyncTask|type=CalibFlushSyncTask|trigger=any_queue_ready|trigger_queues=CalibFlushRequest}"
    ];
    NativeCalibMonitorTask [
      label="{NativeCalibMonitorTask|type=NativeCalibMonitorTask|trigger=any_queue_ready|trigger_queues=NativeCalibStatus}"
    ];

    CalibResourceTask -> CalibCameraAcquireTask [
      taillabel="0", headlabel="0", label="CalibResourceReady\ndepth=1\noverflow=overwrite_oldest"
    ];
    CalibResourceTask -> CalibImuWriterTask [
      taillabel="1", headlabel="0", label="CalibResourceReady\ndepth=1\noverflow=overwrite_oldest"
    ];
    NativeCalibClockTask -> CalibCameraAcquireTask [
      taillabel="0", headlabel="1", label="NativeCalibTick\ndepth=1\noverflow=overwrite_oldest"
    ];
    CalibCameraAcquireTask -> CalibPacingFilterTask [
      taillabel="0", headlabel="0", label="CalibStereoFrame\ndepth=1\noverflow=overwrite_oldest"
    ];
    CalibCameraAcquireTask -> CalibUdpPreviewTask [
      taillabel="1", headlabel="0", label="CalibStereoFrame\ndepth=1\noverflow=overwrite_oldest"
    ];
    CalibCameraAcquireTask -> CalibCompletionTask [
      taillabel="2", headlabel="0", label="CalibCaptureDone\ndepth=1\noverflow=overwrite_oldest"
    ];
    CalibPacingFilterTask -> CalibStorageWriteTask [
      taillabel="0", headlabel="0", label="CalibSavePair\ndepth=2\noverflow=drop_newest"
    ];
    CalibStorageWriteTask -> CalibCompletionTask [
      taillabel="0", headlabel="1", label="CalibStorageStatus\ndepth=8\noverflow=overwrite_oldest"
    ];
    CalibImuWriterTask -> CalibCompletionTask [
      taillabel="0", headlabel="2", label="CalibImuStatus\ndepth=8\noverflow=overwrite_oldest"
    ];
    CalibUdpPreviewTask -> CalibCompletionTask [
      taillabel="0", headlabel="3", label="CalibPreviewStatus\ndepth=8\noverflow=overwrite_oldest"
    ];
    CalibCompletionTask -> CalibFlushSyncTask [
      taillabel="0", headlabel="0", label="CalibFlushRequest\ndepth=1\noverflow=overwrite_oldest"
    ];
    CalibFlushSyncTask -> NativeCalibMonitorTask [
      taillabel="0", headlabel="0", label="NativeCalibStatus\ndepth=4\noverflow=overwrite_oldest"
    ];
  }
}
