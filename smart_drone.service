[Unit]
Description=SmartDrone Unified Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nvidia
SupplementaryGroups=dialout gpio video i2c
WorkingDirectory=/home/nvidia
Environment=HOME=/home/nvidia
Environment=SMART_DRONE_MAVLINK_DEV=/dev/ttyTHS0
Environment=SMART_DRONE_MAVLINK_BAUD=921600
Environment=SMART_DRONE_STEREO_MATCH_DEBUG=1
Environment=SMART_DRONE_DUMP_STEREO_DEBUG=1
Environment=SMART_DRONE_LIGHTGLUE_POINTS=512
Environment=SMART_DRONE_LIGHTGLUE_EVERY_N=4
Environment=SMART_DRONE_LIGHTGLUE_SCORE_ORIENTATION=direct
Environment=SMART_DRONE_LIGHTGLUE_MIN_SCORE=0.02
Environment=SMART_DRONE_LIGHTGLUE_MAX_Y_DIFF_PX=1.5
Environment=SMART_DRONE_LIGHTGLUE_MIN_DISPARITY_PX=0.8
Environment=SMART_DRONE_EXTERNAL_STEREO_INIT_MIN_CLOSE_RATIO=0.30
Environment=SMART_DRONE_EXTERNAL_STEREO_INIT_MIN_FEATURES=72
Environment=SMART_DRONE_EXTERNAL_STEREO_INIT_MIN_CLOSE_POINTS=24
Environment=SMART_DRONE_EXTERNAL_STEREO_DEPTH_SCALE=0.965
Environment=SMART_DRONE_EXTERNAL_STEREO_STABILIZING_FRAME_WINDOW=1200
Environment=SMART_DRONE_EXTERNAL_STEREO_STABILIZING_KF_LIMIT=120
Environment=SMART_DRONE_EXTERNAL_STEREO_MIN_FRAMES_BETWEEN_KF=4
Environment=SMART_DRONE_SP_LG_FILTERED_STEREO_INJECT=1
Environment=SMART_DRONE_SP_LG_INIT_TRUST_FRONTEND_PAIRS=1
Environment=SMART_DRONE_SP_LG_RECOVERY_TRUST_FRONTEND_PAIRS=1
Environment=SMART_DRONE_SP_LG_BOOTSTRAP_TRUST_FRONTEND_PAIRS=1
Environment=SMART_DRONE_SP_LG_TRUST_FRONTEND_PAIRS_OK_STREAK=120
Environment=SMART_DRONE_ORB_LIVE_EUROC_TRAJECTORY_POSE=0
Environment=SMART_DRONE_REALTIME_POSE_CONTINUITY=1
Environment=SMART_DRONE_ONLINE_POSE_STEP_GUARD=1
Environment=SMART_DRONE_ONLINE_POSE_GUARD_MAX_STEP_M=0.08
Environment=SMART_DRONE_ONLINE_POSE_GUARD_MAX_SPEED_MPS=1.6
Environment=SMART_DRONE_ONLINE_POSE_GUARD_MAX_ROT_RAD=0.10
Environment=SMART_DRONE_ONLINE_POSE_GUARD_MAX_ROT_RPS=2.0
Environment=SMART_DRONE_ONLINE_POSE_GUARD_DFX=1
Environment=SMART_DRONE_UDP_STATE_PERIOD_MS=50
Environment=SMART_DRONE_SP_LG_INJECT_DFX=1
Environment=SMART_DRONE_SP_LG_TRACK_DFX=0
Environment=SMART_DRONE_EXTERNAL_STEREO_TRACK_DFX=0
Environment=SMART_DRONE_EXTERNAL_STEREO_POSE_RESCUE=1
Environment=SMART_DRONE_SUPERPOINT_TRT_ENGINE=/home/nvidia/LightGlue/weights/superpoint_dense_640x409_fp16.engine
Environment=SMART_DRONE_LIGHTGLUE_TRT_ENGINE=/home/nvidia/LightGlue/weights/lightglue_superpoint_512_fp16.engine
Environment=SMART_DRONE_TRT_PINNED_HOST_OUTPUT=1
Environment=SMART_DRONE_SUPERPOINT_PARALLEL_POST=1
Environment=SMART_DRONE_SUPERPOINT_DESCRIPTOR_NEAREST=1
Environment=SMART_DRONE_DPVO_REPO=/home/nvidia/DPVO
Environment=SMART_DRONE_DPVO_EPG_PACING=1
Environment=SMART_DRONE_DPVO_ASYNC_UPDATE=1
Environment=SMART_DRONE_DPVO_ASYNC_PUBLISH_SMOOTH=1
Environment=SMART_DRONE_DPVO_ASYNC_PUBLISH_MAX_STEP_M=0.010
Environment=SMART_DRONE_DPVO_ASYNC_PUBLISH_MAX_ROT_RAD=0.018
Environment=SMART_DRONE_DPVO_EPG_HEAVY_EVERY_N=3
Environment=SMART_DRONE_DPVO_EPG_HEAVY_INTERVAL_MS=150
Environment=SMART_DRONE_DPVO_RIGHT_EVERY_N=3
Environment=SMART_DRONE_DPVO_WARMUP_FULL_FRAMES=4
Environment=SMART_DRONE_DPVO_BOOTSTRAP_UPDATE_ITERS=2
Environment=SMART_DRONE_DPVO_UPDATE_ITERS=1
Environment=SMART_DRONE_DPVO_MAX_EDGES=256
Environment=SMART_DRONE_DPVO_CAP_REBUILT_EDGES=1
Environment=SMART_DRONE_DPVO_CUDA_CORR_STRICT_VALIDATE=0
Environment=SMART_DRONE_DPVO_CUDA_DEVICE_UPDATE_CHAIN_VALIDATE=0
Environment=LD_LIBRARY_PATH=/home/nvidia:/home/nvidia/vpi_root/opt/nvidia/vpi2/lib/aarch64-linux-gnu:/home/nvidia/vpi_root/opt/nvidia/cupva-2.3/lib/aarch64-linux-gnu:/usr/local/cuda-11.4/targets/aarch64-linux/lib:/usr/local/cuda/lib64:/usr/lib/aarch64-linux-gnu
ExecStart=/home/nvidia/smart_drone --auto-mode idle --settings /home/nvidia/config/stereo.yaml --w 640 --h 480 --fps 60 --slam-fps 20 --uvc-device-index 0 --uvc-eye-width 640 --uvc-eye-height 480 --uvc-swap-eyes --slam-backend klt --feature-frontend lk_gftt_per_frame --dpvo-repo /home/nvidia/DPVO --udp --udp-ip 127.0.0.1 --udp-port 5000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
