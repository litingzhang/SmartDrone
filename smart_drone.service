[Unit]
Description=SmartDrone Unified Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nvidia
SupplementaryGroups=dialout gpio video i2c
WorkingDirectory=/home/nvidia
Environment=HOME=/home/nvidia
Environment=SMART_DRONE_MAVLINK_DEV=/dev/ttyTHS0
Environment=SMART_DRONE_MAVLINK_BAUD=921600
Environment=SMART_DRONE_STEREO_MATCH_DEBUG=1
Environment=SMART_DRONE_DUMP_STEREO_DEBUG=1
Environment=LD_LIBRARY_PATH=/home/nvidia:/usr/local/cuda-11.4/targets/aarch64-linux/lib:/usr/local/cuda/lib64:/usr/lib/aarch64-linux-gnu
ExecStart=/home/nvidia/smart_drone --auto-mode idle --settings /home/nvidia/config/stereo.yaml --vocab /home/nvidia/ORBvoc.txt --w 640 --h 480 --fps 60 --slam-fps 20 --uvc-device-index 0 --uvc-eye-width 640 --uvc-eye-height 480 --uvc-swap-eyes --feature-frontend lk --lk-xfeat-seeding --lk-loop-closure --lk-loop-scale 1.20 --lk-loop-relax 1.40 --xfeat-device cuda --xfeat-repo /home/nvidia/accelerated_features --xfeat-worker /home/nvidia/scripts/xfeat_keypoint_worker.py --xfeat-top-k 1024 --xfeat-max-points 768 --xfeat-input-max-width 640 --xfeat-input-max-height 480 --udp --udp-ip 127.0.0.1 --udp-port 5000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
